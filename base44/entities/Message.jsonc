{
  "name": "Message",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "dm",
        "player",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "dice_roll": {
      "type": "object",
      "properties": {}
    },
    "roll_request": {
      "type": "object",
      "properties": {}
    },
    "metadata": {
      "type": "object",
      "properties": {}
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "session_id",
    "sender",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}