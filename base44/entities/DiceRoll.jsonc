{
  "name": "DiceRoll",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "npc_id": {
      "type": "string"
    },
    "dice_type": {
      "type": "string"
    },
    "modifier": {
      "type": "number",
      "default": 0
    },
    "result": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "dc": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "advantage": {
      "type": "boolean",
      "default": false
    },
    "disadvantage": {
      "type": "boolean",
      "default": false
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "campaign_id",
    "dice_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}