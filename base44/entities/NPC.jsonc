{
  "name": "NPC",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "faction": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "alive"
    },
    "known_info": {
      "type": "string"
    },
    "history": {
      "type": "string"
    },
    "is_hostile": {
      "type": "boolean",
      "default": false
    },
    "disposition": {
      "type": "number",
      "default": 0
    },
    "portrait": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "npc",
        "monster"
      ],
      "default": "npc"
    },
    "monster_type": {
      "type": "string"
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "change": {
            "type": "number"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "campaign_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}