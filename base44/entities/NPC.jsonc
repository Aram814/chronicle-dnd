{
  "name": "NPC",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "faction": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "alive"
    },
    "known_info": {
      "type": "string"
    },
    "history": {
      "type": "string"
    },
    "is_hostile": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "campaign_id",
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}