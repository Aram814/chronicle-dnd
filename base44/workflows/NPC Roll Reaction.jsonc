{
  "name": "NPC Roll Reaction",
  "description": "When a player rolls against an NPC, evaluates the result \u2014 on success improves NPC disposition and posts a congratulatory message; on a critical failure (natural 1) invokes the DM engine to generate and persist a negative consequence.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "DiceRoll",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.npc_id != null and .trigger.data.npc_id != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "npc_roll_reaction",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "evaluate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "evaluate_npc_roll",
            "args": {
              "roll_id": "${ .trigger.entity_id }",
              "user_id": "${ .trigger.data.created_by_id }"
            }
          },
          "then": "branch",
          "x-base44": {
            "title": "Evaluate NPC roll",
            "description": "Success, critical failure, or neutral"
          }
        }
      },
      {
        "branch": {
          "switch": [
            {
              "when": "${ .evaluate.outcome == \"critical_failure\" }",
              "then": "generate_consequence"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Branch on outcome"
          }
        }
      },
      {
        "generate_consequence": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dm_engine",
            "args": {
              "mode": "npc_consequence",
              "roll_id": "${ .evaluate.roll_id }",
              "user_id": "${ .trigger.data.created_by_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate and post consequence",
            "description": "DM engine narrates the failure and posts it to the campaign"
          }
        }
      }
    ]
  }
}